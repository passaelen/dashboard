<script>

// ===== HELPERS =====
function euro(v){
    return Math.round(v).toLocaleString('fr-BE') + " €";
}

// ===== COULEUR TYPE =====
function getClassByType(type){
    switch(type){
        case "ETF_MONDE": return "dot-monde";
        case "OR": return "dot-or-suisse";
        case "ARGENT": return "dot-argent";
        default: return "";
    }
}



function euro(v){
    return Math.round(v).toLocaleString('fr-BE') + " €";
}


function getClassByType(type){
    switch(type){
        case "ETF_MONDE": return "dot-monde";
        case "OR": return "dot-or-suisse";
        case "ARGENT": return "dot-argent";
        default: return "";
    }
}


function parseDateFR(date){
    const [d,m,y] = date.split("/");
    return new Date(`${y}-${m}-${d}`);
}





// ===== RENDER =====
function renderAchats(){

    const tbody = document.getElementById("table-achats");

    if (!tbody) {
        console.error("tbody introuvable");
        return;
    }

    if (!window.achats || achats.length === 0) {
        tbody.innerHTML = `<tr><td colspan="4">Aucun achat</td></tr>`;
        console.warn("Aucun achat trouvé");
        return;
    }

    const sorted = [...achats].sort((a,b)=>{
        return parseDateFR(b.date) - parseDateFR(a.date);
    });

    tbody.innerHTML = ""; // reset

    sorted.forEach(a => {

        const row = document.createElement("tr");

        row.innerHTML = `
            <td>${a.date}</td>
            <td>
                <span class="dot ${getClassByType(a.type)}"></span>
                ${a.type}
            </td>
            <td>${a.label}</td>
            <td>${euro(a.montant)}</td>
        `;

        tbody.appendChild(row);
    });
}

document.addEventListener("DOMContentLoaded", renderAchats);

renderAchats();

const total = sorted.reduce((sum, a) => sum + (a.montant || 0), 0);
document.getElementById("total-achats").innerText = euro(total);

</script>

